# =====================================================================
# Portfolio — Environment Variables
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local` to git.
# =====================================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- GitHub ----------
# Personal Access Token (public_repo scope) — boosts rate limit to 5000/hr
GITHUB_TOKEN=ghp_your_personal_access_token_here
NEXT_PUBLIC_GITHUB_USERNAME=Rohithburla51

# ---------- LeetCode (live stats via Alfa API) ----------
LEETCODE_API_BASE=https://alfa-leetcode-api.onrender.com
NEXT_PUBLIC_LEETCODE_USERNAME=ROHITH_PROGRAMMER

# ---------- Resend (Contact form email) ----------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=burlarohith999@gmail.com

# ---------- Cloudflare Turnstile (anti-spam) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ---------- Analytics ----------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Burla Rohith — Portfolio
